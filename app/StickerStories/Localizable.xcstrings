    "Softer, slower sticker effects while stories play. Also follows the system Reduce Motion setting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanftere, langsamere Sticker-Effekte, während Geschichten laufen. Folgt auch der Systemeinstellung „Bewegung reduzieren“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efectos de pegatinas más suaves y lentos mientras suenan los cuentos. También sigue el ajuste Reducir movimiento del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des effets d’autocollants plus doux et plus lents pendant les histoires. Suit aussi le réglage système « Réduire les animations »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effetti degli adesivi più delicati e lenti durante le storie. Segue anche l’impostazione di sistema «Riduci movimento»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
