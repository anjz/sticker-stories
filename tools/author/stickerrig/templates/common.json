{
 "about": "Actions most characters can play, written against the shared names below; a rig without a bone or slot simply leaves it out (install lists what it dropped). Signs: turns are clockwise, so an arm on the viewer's left (armL) rises with +r and one on the right (armR) with -r; y is down. Tune per character by copying the keys into its rig file.",
 "bones": {
  "root": "where it touches the ground (or its centre, for a flyer); moves the whole character",
  "body": "the torso, pivot at its base",
  "belly": "the body's art alone, for squash and breathing",
  "head": "the head, pivot at the neck",
  "face": "on the head: carries the eyes, brows and mouth (a sideways shift turns the face)",
  "eyeL, eyeR, eye": "the eyes (eye: a single one in profile)",
  "browL, browR": "brows",
  "mouth": "the mouth",
  "beak": "a bird's beak",
  "armL, armR": "arms or front legs held up, pivot at the shoulder",
  "legL, legR": "legs, pivot at the hip",
  "footL, footR": "a bird's feet",
  "earL, earR": "ears",
  "tail": "the tail, pivot at its base",
  "wingL, wingR": "wings, pivot at the shoulder",
  "antennaL, antennaR": "antennae"
 },
 "slots": {
  "eyeL, eyeR, eye": "default (as in the sticker), wide, closed, happy, sad",
  "mouth": "default (as in the sticker), open (laughing), o, sad",
  "beak": "closed, open",
  "browL, browR": "default, sad",
  "wingL, wingR": "folded, open"
 },
