{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ stories are still downloading — playing in %@ for now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Geschichten auf %1$@ werden noch geladen – so lange laufen sie auf %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cuentos en %1$@ aún se están descargando: mientras tanto, suenan en %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les histoires en %1$@ sont encore en téléchargement : en attendant, elles sont lues en %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le storie in %1$@ si stanno ancora scaricando: nel frattempo le ascolti in %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@のおはなしはダウンロード中です。それまでは%2$@で再生します。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@故事仍在下載中，暫時先以%2$@播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@故事還在下載中，目前先以%2$@播放。"
          }
        }
      }
    },
